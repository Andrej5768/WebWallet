# Copy to .env and adjust. .env is not committed.

# Base64-encoded key of at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
# Encrypts bank tokens in the database; changing it makes stored tokens unreadable: openssl rand -base64 32
ENCRYPTION_KEY=
# Public URL of the backend for bank webhooks (optional; without it operations are polled)
APP_PUBLIC_URL=

DB_PASSWORD=webwallet
APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
