# Copy to .env and adjust. .env is not committed.

# Base64-encoded key of at least 32 bytes: openssl rand -base64 32
JWT_SECRET=
# Encrypts bank tokens in the database; changing it makes stored tokens unreadable: openssl rand -base64 32
ENCRYPTION_KEY=
# Password of the PostgreSQL user; the `local` profile expects "webwallet"
DB_PASSWORD=
# Public URL of the backend for bank webhooks (optional; without it operations are polled)
APP_PUBLIC_URL=

APP_FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Production mail server (Mailpit is used when MAIL_HOST is not set)
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true
# MAIL_FROM=no-reply@example.com

# Sign-in with Google: an OAuth web client in Google Cloud with the redirect URI
# <APP_FRONTEND_URL>/api/v1/auth/google/callback; the button is hidden while these are empty
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Logged errors of the backend are emailed here, at most one email per 15 minutes
# ALERT_EMAIL=

# The demo sandbox ("Try the demo" without registration); accounts live APP_DEMO_TTL and are then deleted
# APP_DEMO_ENABLED=true
# APP_DEMO_TTL=24h

# The Android app: versions below the minimum must update, versions below the latest are offered an update
# APP_ANDROID_MIN_VERSION_CODE=1
# APP_ANDROID_LATEST_VERSION_CODE=1
# APP_ANDROID_STORE_URL=https://play.google.com/store/apps/details?id=org.andrewdev.webwallet

# Behind a reverse proxy in a Docker network: a regular expression of its address
# TRUSTED_PROXIES=172\.18\.0\.\d+

# Refresh token cookie without the Secure flag, only for development over plain HTTP on a host other than localhost
# REFRESH_COOKIE_SECURE=false
